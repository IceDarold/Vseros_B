 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Vseros_B Kaggle Pipeline\n",
    "Основной end-to-end запуск (без тяжёлых exp103/104/105 — они должны быть предрасчитаны)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1) Зависимости\n",
    "!pip install -q --upgrade pip\n",
    "!pip install -q wandb lightgbm catboost xgboost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2) Бутстрап окружения\n",
    "import os, pathlib, time, subprocess\n",
    "from typing import Optional\n",
    "\n",
    "WORKDIR = pathlib.Path('/kaggle/working')\n",
    "REPO_URL = 'https://github.com/artyomkonukhov/Vseros_B.git'\n",
    "REPO_DIR = WORKDIR / 'Vseros_B'\n",
    "\n",
    "if not REPO_DIR.exists():\n",
    "    !git clone $REPO_URL $REPO_DIR\n",
    "os.chdir(REPO_DIR)\n",
    "os.environ['PYTHONPATH'] = str(REPO_DIR / 'src')\n",
    "os.environ.setdefault('VPERIOD_RUN_ID', time.strftime('%Y%m%d-%H%M%S'))\n",
    "RUN_ID = os.environ['VPERIOD_RUN_ID']\n",
    "\n",
"try:\n",
"    from kaggle_secrets import UserSecretsClient  # type: ignore\n",
"    wandb_key: Optional[str] = UserSecretsClient().get_secret('WANDB_API_KEY')\n",
"except Exception:\n",
"    wandb_key = None\n",
"if wandb_key:\n",
"    os.environ['WANDB_API_KEY'] = wandb_key\n",
"    subprocess.run(['wandb', 'login', wandb_key, '--relogin'], check=False)\n",
"else:\n",
"    print('WARN: WANDB_API_KEY не найден (kaggle_secrets), W&B будет работать в offline-режиме')\n",
"    os.environ['WANDB_MODE'] = 'offline'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3) Подготовка данных\n",
    "!python -m vseros_b.cli prepare-data --config kaggle.yaml --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 4) Быстрые кандидаты (exp103/104/105 подтягиваются из W&B артефактов)\n",
    "!python -m vseros_b.cli build-candidates --config kaggle.yaml --experiments \
",
    "    exp101_pop_decay exp102_daily_trending exp106_lightgcn_import exp107_ppr \
",
    "    --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 5) Сведение пулов кандидатов\n",
    "!python -m vseros_b.cli fuse-candidates --config kaggle.yaml --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 6) Построение матриц признаков\n",
    "!python -m vseros_b.cli build-features --cand-source exp108_recall_fusion --features all --out-tag kaggle_v1 --config kaggle.yaml \
",
    "    --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 7) Обучение базовых ранкеров и промежуточные сабмиты\n",
    "!python -m vseros_b.cli train-ranker --experiments exp201_ranker_lgbm --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli train-ranker --experiments exp202_ranker_catboost --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli train-ranker --experiments exp203_ranker_xgb --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli train-ranker --experiments exp204_ranker_mlp --config kaggle.yaml --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 8) Стекинг и калибровка\n",
    "!python -m vseros_b.cli train-ranker --experiments exp205_ranker_stacking --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli train-ranker --experiments exp206_calibration --config kaggle.yaml --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 9) Финальный бленд, rerank и запасные сабмиты\n",
    "!python -m vseros_b.cli blend --experiments exp301_blend_linear --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli rerank --experiments exp302_mmr_rerank exp303_hard_rules --config kaggle.yaml --run-id $RUN_ID\n",
    "!python -m vseros_b.cli make-submission --experiment exp304_fallbacks --config kaggle.yaml --run-id $RUN_ID"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 10) Контроль качества и предпросмотр сабмитов\n",
    "!python -m vseros_b.cli report --config kaggle.yaml\n",
    "\n",
    "import pandas as pd, pathlib\n",
    "sub_dir = pathlib.Path('submissions')\n",
    "for path in sorted(sub_dir.glob('*.csv')):\n",
    "    df = pd.read_csv(path).head()\n",
    "    print(f'Preview {path.name}:')\n",
    "    display(df)"
   ]
  }
 ],
